rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Connection test document - must be public
    match /test/connection {
      allow get: if true;
    }

    // Global Safety Net (Deny all by default)
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }
    
    function existing() {
      return resource.data;
    }

    // Echo Validation
    function isValidEcho(data) {
      return data.keys().hasAll(['userId', 'timestamp', 'transcript'])
        && data.keys().size() == 3
        && data.userId == request.auth.uid
        && data.timestamp == request.time // Strict server timestamp
        && data.transcript is list
        && data.transcript.size() <= 200 // Prevent resource exhaustion
        && (data.transcript.size() == 0 || (
             data.transcript[0].keys().hasAll(['text', 'role']) &&
             data.transcript[0].text is string &&
             data.transcript[0].text.size() <= 10000 &&
             data.transcript[0].role in ['user', 'model']
           ));
    }

    // Match hierarchy from blueprint
    match /users/{userId} {
      allow get: if isOwner(userId);
      
      match /echoes/{echoId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidEcho(incoming());
        allow delete: if isOwner(userId);
        // No updates allowed - echoes are immutable moments
      }
    }

  }
}
